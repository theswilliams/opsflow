# Copy to .env, or run `npm run setup` to generate one with random secrets.
DATABASE_URL="postgresql://opsflow:CHANGE_ME@localhost:54329/opsflow"
APP_URL="http://localhost:3000"
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# "mock" (deterministic demo provider) or "claude"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Password for the seeded demo user demo@opsflow.test (seed refuses to run without it)
DEMO_USER_PASSWORD=""
# Set to "true" ONLY when running behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY="false"
