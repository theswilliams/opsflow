# Copy to .env, or run `npm run setup` to generate one with random secrets.
DATABASE_URL="postgresql://opsflow:CHANGE_ME@localhost:54329/opsflow"
APP_URL="http://localhost:3000"
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
# "mock" (deterministic demo provider) or "claude"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# IANA time zone used to resolve "today" and "Friday". Validated at startup.
BUSINESS_TIMEZONE="America/Toronto"
# Password for the seeded demo user demo@opsflow.test (seed refuses to run without it)
DEMO_USER_PASSWORD=""

# --- AI spend controls, per user (0 = no limit for that ceiling; empty = default) ---
AI_DAILY_REQUEST_BUDGET="200"
AI_DAILY_TOKEN_BUDGET="400000"
# Enforced only when both prices are set AND the provider reports token usage.
AI_MONTHLY_COST_BUDGET_USD="0"
AI_PRICE_INPUT_USD_PER_MTOK=""
AI_PRICE_OUTPUT_USD_PER_MTOK=""

# --- Abuse controls ---
MAX_CREDENTIALS_PER_USER="5"
WEBHOOK_KEY_LIMIT_PER_MIN="60"
WEBHOOK_TENANT_LIMIT_PER_MIN="120"

# --- Client address trust (see docs/SECURITY.md#client-address-trust-model) ---
# `npm start` uses server.mjs, which stamps the real TCP peer on every request. Only if a reverse proxy sits in
# front, list ITS address(es)/CIDRs here so X-Forwarded-For is honoured (rightmost untrusted hop wins).
TRUSTED_PROXIES=""
# Serverless/platform mode without socket access: number of trusted proxy hops appending to X-Forwarded-For.
TRUST_PROXY_HOPS="0"

# --- Background work ---
# Set to "off" on the web process when you run `npm run worker` separately.
OPSFLOW_WORKER="on"
JOB_LEASE_SECONDS="120"
JOB_MAX_ATTEMPTS="3"
PDF_TIMEOUT_MS="10000"

# --- Data retention (docs/DATA.md): documents and extracted data are purged this many days after a workflow finishes. 0 = never ---
RETENTION_DAYS="90"

# --- Content-Security-Policy: "enforce" (default) | "report-only" | "off" (diagnosis only) ---
CSP_MODE="enforce"
